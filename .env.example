# Required for Gemini semantic judging. If omitted, the app runs deterministic-only.
GEMINI_API_KEY=
# Current default can be overridden without code changes.
GEMINI_MODEL=gemini-3.7-flash
PORT=3000
# Comma-separated browser origins. Empty = same-origin only.
ALLOWED_ORIGINS=
# Max prompt/context characters accepted by API.
MAX_PROMPT_CHARS=30000
MAX_CONTEXT_CHARS=60000
